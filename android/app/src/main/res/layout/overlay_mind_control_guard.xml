<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_gravity="top"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_overlay_chart" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/overlay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.04"
                    android:text="MIND CONTROL GUARD"
                    android:textColor="@color/overlay_navy"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- ── is Active ── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_overlay_fade_line_left" />

                    <TextView
                        android:id="@+id/overlay_active_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="is Active"
                        android:textColor="@color/overlay_purple"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_overlay_fade_line_right" />
                </LinearLayout>

                <!-- Brain circle: 140dp, white center, thin 2dp purple border, NO shadow -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_overlay_brain_circle"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/overlay_brain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Mind Control Guard"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_zeno_brain_nobg" />
                </FrameLayout>

                <!-- Powered by zeno AI: short fading lines -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_overlay_fade_line_left" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Powered by "
                        android:textColor="@color/overlay_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="zeno"
                        android:textColor="@color/overlay_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_overlay_ai_badge"
                        android:paddingStart="7dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="3dp"
                        android:text="AI"
                        android:textColor="@color/overlay_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_overlay_fade_line_right" />
                </LinearLayout>

                <!-- Status icon in light blue circle -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_overlay_status_circle">

                    <ImageView
                        android:id="@+id/overlay_status_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_overlay_hourglass" />
                </FrameLayout>

                <TextView
                    android:id="@+id/overlay_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="No new signal yet"
                    android:textColor="@color/overlay_purple"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_status_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="from the Analyst"
                    android:textColor="@color/overlay_navy"
                    android:textSize="15sp" />

                <View
                    android:layout_width="56dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/overlay_line" />

                <!-- FOMO card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_overlay_fomo_card"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_overlay_icon_circle"
                        android:contentDescription="@null"
                        android:padding="11dp"
                        android:src="@drawable/ic_overlay_target" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/overlay_card_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Save yourself\nfrom FOMO."
                            android:textColor="@color/overlay_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/overlay_card_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Mind control traders\nwait for right signal, not the noise."
                            android:textColor="@color/overlay_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom buttons: taller 62dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/overlay_btn_control"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="3"
            android:background="@drawable/bg_overlay_control_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_overlay_shield" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.02"
                android:text="I WILL CONTROL"
                android:textColor="@color/overlay_white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlay_btn_skip"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="2"
            android:background="@drawable/bg_overlay_skip_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="SKIP"
                android:textColor="@color/overlay_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_overlay_arrow" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
